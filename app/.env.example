DATABRICKS_SERVER_HOSTNAME=adb-<workspace-id>.<region>.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<use-a-secret-manager-or-local-secret>
DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Job IDs for the existing audited operator actions.
CONTOSO_REQUEUE_DEAD_LETTER_WORK_ITEM_JOB_ID=<job-id>
CONTOSO_RELEASE_QUARANTINED_DELIVERY_JOB_ID=<job-id>
CONTOSO_SUPERSEDE_DELIVERY_JOB_ID=<job-id>
CONTOSO_LAKEHOUSE_MAINTENANCE_JOB_ID=<job-id>