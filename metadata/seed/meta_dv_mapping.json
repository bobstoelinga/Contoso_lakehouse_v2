  { "dv_mapping_id": "DVM-BVOL-01", "dv_entity_id": "SAT_ORDER_LINE_BV", "source_object_id": "SALES.ORDERS", "source_expression": "cast(quantity * unit_price as decimal(18,4))",                                        "target_column": "gross_amount",     "target_data_type": "DECIMAL(18,4)", "column_role": "DESCRIPTIVE", "is_in_hashdiff": true, "ordinal_position": 1, "is_active": true },
