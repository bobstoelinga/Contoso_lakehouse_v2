  { "dv_mapping_id": "DVM-BVCUST-01", "dv_entity_id": "SAT_CUSTOMER_BV", "source_object_id": "SALES.CUSTOMERS", "source_expression": "concat_ws(', ', nullif(address_line1,''), nullif(city,''), nullif(state_province,''), nullif(postal_code,''), nullif(country_code,''))", "target_column": "full_address", "target_data_type": "STRING", "column_role": "DESCRIPTIVE", "is_in_hashdiff": true, "ordinal_position": 1, "is_active": true },
  { "dv_mapping_id": "DVM-BVCUST-02", "dv_entity_id": "SAT_CUSTOMER_BV", "source_object_id": "SALES.CUSTOMERS", "source_expression": "CASE WHEN customer_segment IN ('CORPORATE','WHOLESALE') THEN 'B2B' WHEN customer_segment IN ('RETAIL','ONLINE') THEN 'B2C' ELSE 'UNKNOWN' END", "target_column": "customer_type", "target_data_type": "STRING", "column_role": "DESCRIPTIVE", "is_in_hashdiff": true, "ordinal_position": 2, "is_active": true },
  { "dv_mapping_id": "DVM-BVCUST-03", "dv_entity_id": "SAT_CUSTOMER_BV", "source_object_id": "SALES.CUSTOMERS", "source_expression": "CASE WHEN customer_since IS NULL THEN 'UNKNOWN' WHEN months_between(current_date(), customer_since) < 12 THEN 'NEW' WHEN months_between(current_date(), customer_since) < 60 THEN 'ESTABLISHED' ELSE 'LOYAL' END", "target_column": "tenure_band", "target_data_type": "STRING", "column_role": "DESCRIPTIVE", "is_in_hashdiff": true, "ordinal_position": 3, "is_active": true },
