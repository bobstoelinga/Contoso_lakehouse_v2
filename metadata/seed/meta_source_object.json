    "bronze_partition_columns": ["_delivery_date"],

    "checkpoint_path": "/Volumes/raw_${env}/sales/checkpoints/bronze/br_customers/_checkpoint",
    "schema_location_path": "/Volumes/raw_${env}/sales/checkpoints/bronze/br_customers/_schema",
    "schema_evolution_mode": "addNewColumns",
    "max_files_per_trigger": 1000,

    "quality_catalog": "contoso_quality_${env}",
    "quality_schema": "sales",
    "quality_table": "qa_customers",
    "reject_catalog": "contoso_reject_${env}",
    "reject_schema": "sales",
    "reject_table": "rj_customers",

    "load_order": 10,
    "schema_drift_policy": "ALLOW_NEW_COLUMNS_WITH_APPROVAL",
    "owner_team": "sales_domain",
    "criticality": "HIGH",
    "is_active": true
  },
