[
  {
    "source_object_id": "SALES.CUSTOMERS",
    "source_system_id": "SALES",
    "object_name": "customers",
    "file_pattern": "customers*.parquet",
    "file_format": "parquet",
    "reader_options": { "mergeSchema": "true" },

    "load_strategy": "SNAPSHOT_SCD2",
